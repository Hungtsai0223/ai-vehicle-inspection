# LOCAL DEMO: no backend needed. Keep true for Vercel Hackathon demos.
NEXT_PUBLIC_USE_MOCK_AI=true
# HTTP DEV STUB: set mock=false; this URL works only with npm run dev.
NEXT_PUBLIC_AI_API_URL=/api/dev
# Absolute local example (change port if needed): http://localhost:3001/api/dev
# Presentation scenario: potential_damage / no_damage / multiple_damage / unknown_area / backend_error
NEXT_PUBLIC_DEMO_RESULT=potential_damage
# Explicit Demo shortcuts/fallbacks in a production HTTP presentation. Set false for real-service deployments.
NEXT_PUBLIC_ENABLE_DEMO=true
# Development stub only; ignored by Mock and production.
# NEXT_PUBLIC_DEV_AI_RESULT=potential_damage
# REAL AI BACKEND: mock=false and API URL=https://<teammate-backend-host>
